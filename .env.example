# ==============================================================================
# Dating App Infrastructure - Environment Variables Template
# Rule: Never commit real credentials to VCS. Duplicate this file as .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# RustFS S3-Compatible Object Storage Credentials
RUSTFS_ACCESS_KEY=your_rustfs_access_key_here
RUSTFS_SECRET_KEY=your_rustfs_secret_key_here

# Container Images (GitHub Container Registry)
BACKEND_IMAGE=ghcr.io/mai-ru-software-house/dating-backend:dev
MATCH_ENGINE_IMAGE=ghcr.io/mai-ru-software-house/dating-match-engine:dev

# Argon2 Hashing Configuration (Password Security)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Watchtower Configuration (Auto-update dev containers on image changes)
WATCHTOWER_POLL_INTERVAL=30

# Backend (api) Configuration
# JWT_SECRET must be a long random string, for example: openssl rand -hex 32
JWT_SECRET=your_long_random_jwt_secret_here
# Comma separated list of mobile app origins allowed by CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# RustFS bucket for profile photos (create it once in RustFS)
RUSTFS_BUCKET=mairu-photos
# Place name lookup (OpenStreetMap Nominatim)
NOMINATIM_URL=https://nominatim.openstreetmap.org
